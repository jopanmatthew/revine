# revine. web app environment (PRD §12.4). Copy to .env.local for local development.
# Contract addresses and ABIs live in src/lib/contracts.ts, not here.

# Public (inlined into the browser bundle)
NEXT_PUBLIC_CHAIN_ID=11155111
# Alchemy Sepolia RPC; restrict the key to your domains
NEXT_PUBLIC_RPC_URL=
# Free WalletConnect (Reown) project ID for RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# true locally until the real hooks are wired; false on Vercel
NEXT_PUBLIC_USE_MOCKS=true
# Shows demo helpers such as [Fill demo invoice] and [Use demo buyer]
NEXT_PUBLIC_DEMO_MODE=true

# Server only. Never add a NEXT_PUBLIC_ prefix to these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ATTESTER_PRIVATE_KEY=

# SEPOLIA_RPC_URL, DEPLOYER_PRIVATE_KEY and ETHERSCAN_API_KEY belong in contracts/.env (never committed), not here.
