# Revine web app environment. Copy to .env.local for local development.
# Public contract address overrides (defaults point to the old fingerprint-only deployment).
NEXT_PUBLIC_MOCK_IDR_ADDRESS=
NEXT_PUBLIC_REVINE_INVOICE_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_BLOCK=

# Public (inlined into the browser bundle)
NEXT_PUBLIC_CHAIN_ID=11155111
# Alchemy Sepolia RPC; restrict the key to your domains
NEXT_PUBLIC_RPC_URL=
# Free WalletConnect (Reown) project ID for RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# true for the simulated local demo; set false only after Supabase is initialized
NEXT_PUBLIC_USE_MOCKS=true
# Shows demo helpers such as [Fill demo invoice] and [Use demo buyer]
NEXT_PUBLIC_DEMO_MODE=true
# Only enable after deploying the matching generated verifiers and a new RevineInvoice.
NEXT_PUBLIC_ZK_PROOFS_ENABLED=false

# Server only. Never add a NEXT_PUBLIC_ prefix to these.
SUPABASE_URL=
# Server secret key (sb_secret_...) or the legacy service_role JWT; never a public key.
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated synthetic Demo Bank signer only; never use a MetaMask wallet key.
ATTESTER_PRIVATE_KEY=

# SEPOLIA_RPC_URL, DEPLOYER_PRIVATE_KEY and ETHERSCAN_API_KEY belong in contracts/.env (never committed), not here.
