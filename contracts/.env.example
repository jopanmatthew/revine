# Copy to .env. Keep all private keys out of version control.
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
DEPLOYER_PRIVATE_KEY=

# Optional: reuse the existing Sepolia mIDR token instead of deploying another one.
MOCK_IDR_ADDRESS=

# Optional: set these to submit a faucet transaction for each demo wallet during deployment.
# Otherwise, each demo wallet can call MockIDR.faucet() directly.
DEMO_SELLER_PRIVATE_KEY=
DEMO_BUYER_PRIVATE_KEY=
DEMO_FINANCIER_PRIVATE_KEY=
