pragma solidity ^0.8.30;

import {Test} from "forge-std/Test.sol";
import {IVerifier} from "../src/verifiers/IVerifier.sol";

contract InvoiceVerifierIntegrationTest is Test {
    bytes private constant PROOF = hex"";
    IVerifier private verifier;

    function setUp() public {
        bytes memory code = vm.getCode("src/verifiers/InvoiceVerifier.sol:HonkVerifier");
        address deployed;
        assembly { deployed := create(0, add(code, 0x20), mload(code)) }
        require(deployed != address(0), "invoice verifier deployment failed");
        verifier = IVerifier(deployed);
    }

    function testAcceptsInvoiceProofFromBrowserBackend() public view {
        bytes32[] memory inputs = new bytes32[](5);
        inputs[0] = bytes32(uint256(1));
        inputs[1] = bytes32(uint256(2));
        inputs[2] = bytes32(uint256(50));
        inputs[3] = bytes32(uint256(1_800_000_000));
        inputs[4] = bytes32(uint256(0x23aee9fa17e14df76c47f3a7a4b8d639e190d60f9c07426bc93a8d7e5b7e478c));
        assertTrue(verifier.verify(PROOF, inputs));
    }

    function testRejectsInvoiceProofWithChangedCommitment() public {
        bytes32[] memory inputs = new bytes32[](5);
        inputs[0] = bytes32(uint256(1));
        inputs[1] = bytes32(uint256(2));
        inputs[2] = bytes32(uint256(50));
        inputs[3] = bytes32(uint256(1_800_000_000));
        inputs[4] = bytes32(uint256(0x23aee9fa17e14df76c47f3a7a4b8d639e190d60f9c07426bc93a8d7e5b7e478c) + 1);
        vm.expectRevert();
        verifier.verify(PROOF, inputs);
    }
}

contract CreditVerifierIntegrationTest is Test {
    bytes private constant PROOF = hex"";
    IVerifier private verifier;

    function setUp() public {
        bytes memory code = vm.getCode("src/verifiers/CreditVerifier.sol:HonkVerifier");
        address deployed;
        assembly { deployed := create(0, add(code, 0x20), mload(code)) }
        require(deployed != address(0), "credit verifier deployment failed");
        verifier = IVerifier(deployed);
    }

    function testAcceptsSignedRevenueThresholdProof() public view {
        bytes32[] memory inputs = new bytes32[](3);
        inputs[0] = bytes32(uint256(uint160(0xF779D59bEf219cAeB6C8e3F4bfCdf3aB7DE52Be3)));
        inputs[1] = bytes32(uint256(100_000_000));
        inputs[2] = bytes32(uint256(1_800_000_000));
        assertTrue(verifier.verify(PROOF, inputs));
    }

    function testRejectsCreditProofForChangedThreshold() public {
        bytes32[] memory inputs = new bytes32[](3);
        inputs[0] = bytes32(uint256(uint160(0xF779D59bEf219cAeB6C8e3F4bfCdf3aB7DE52Be3)));
        inputs[1] = bytes32(uint256(100_000_001));
        inputs[2] = bytes32(uint256(1_800_000_000));
        vm.expectRevert();
        verifier.verify(PROOF, inputs);
    }
}
