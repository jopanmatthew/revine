mod sha256;
use sha256::digest;
use std::ecdsa_secp256k1::verify_signature;

// Public key for the dedicated local Demo Bank signer. Its private key stays in
// apps/web/.env.local and must be configured server-side for any hosted demo.
global ATTESTER_PUBKEY_X: [u8; 32] = [
    0xfe, 0x0f, 0xaf, 0x66, 0x55, 0x15, 0x5a, 0x98, 0x56, 0xa6, 0x89, 0xe4, 0xac, 0x1f, 0x6c, 0x21,
    0xc5, 0x98, 0xff, 0x22, 0xd7, 0xf0, 0x15, 0x9b, 0x6f, 0xb0, 0x26, 0xcf, 0xf5, 0x0b, 0x3e, 0xae,
];
global ATTESTER_PUBKEY_Y: [u8; 32] = [
    0x24, 0xde, 0x1e, 0x34, 0xb2, 0xdd, 0x4d, 0x8f, 0xe5, 0xd3, 0x0c, 0x44, 0x67, 0x7f, 0xfd, 0xb6,
    0xf8, 0x5d, 0x2b, 0x54, 0x14, 0x0c, 0xc9, 0xc5, 0x58, 0x6f, 0xe4, 0xb8, 0x16, 0x99, 0xd9, 0x84,
];

fn main(
    seller: pub Field,
    threshold: pub u64,
    attested_at: pub u64,
    revenue: u64,
    signature: [u8; 64],
) {
    assert(revenue >= threshold);

    let seller_bytes: [u8; 20] = seller.to_be_bytes();
    let revenue_bytes: [u8; 8] = (revenue as Field).to_be_bytes();
    let time_bytes: [u8; 8] = (attested_at as Field).to_be_bytes();
    let mut message = [0; 36];
    for i in 0..20 {
        message[i] = seller_bytes[i];
    }
    for i in 0..8 {
        message[20 + i] = revenue_bytes[i];
        message[28 + i] = time_bytes[i];
    }
    let message_hash = digest(message);
    assert(verify_signature(ATTESTER_PUBKEY_X, ATTESTER_PUBKEY_Y, signature, message_hash));
}

#[test]
fn demo_attestation_proves_revenue_threshold() {
    main(
        1412837718541040920250804050962507973189991476195,
        100_000_000,
        1_800_000_000,
        180_000_000,
        [
            0xfd, 0x38, 0x97, 0x06, 0x9d, 0xfc, 0x48, 0xc5, 0x55, 0x1e, 0xce, 0x17, 0x25, 0x1c, 0x06, 0x4e,
            0x14, 0x94, 0xae, 0xea, 0x30, 0x37, 0x93, 0x83, 0x5e, 0x89, 0xf0, 0xfa, 0xff, 0xa1, 0xfe, 0x86,
            0x23, 0x51, 0x3d, 0xf6, 0x28, 0x92, 0x72, 0x9f, 0x90, 0xbb, 0x0e, 0x09, 0xdc, 0xb7, 0xcd, 0x95,
            0x3a, 0x3c, 0xa9, 0x7a, 0x15, 0xdf, 0x16, 0x7b, 0xd6, 0xe2, 0xac, 0xe7, 0x55, 0x20, 0xbe, 0xa4,
        ],
    );
}

#[test(should_fail)]
fn rejects_threshold_above_signed_revenue() {
    main(
        1412837718541040920250804050962507973189991476195,
        200_000_000,
        1_800_000_000,
        180_000_000,
        [
            0xfd, 0x38, 0x97, 0x06, 0x9d, 0xfc, 0x48, 0xc5, 0x55, 0x1e, 0xce, 0x17, 0x25, 0x1c, 0x06, 0x4e,
            0x14, 0x94, 0xae, 0xea, 0x30, 0x37, 0x93, 0x83, 0x5e, 0x89, 0xf0, 0xfa, 0xff, 0xa1, 0xfe, 0x86,
            0x23, 0x51, 0x3d, 0xf6, 0x28, 0x92, 0x72, 0x9f, 0x90, 0xbb, 0x0e, 0x09, 0xdc, 0xb7, 0xcd, 0x95,
            0x3a, 0x3c, 0xa9, 0x7a, 0x15, 0xdf, 0x16, 0x7b, 0xd6, 0xe2, 0xac, 0xe7, 0x55, 0x20, 0xbe, 0xa4,
        ],
    );
}
